<?xml version="1.0" encoding="utf-8" ?>
<SonarQubeAnalysisProperties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">

	<!-- Only include App and Business projects for analysis -->
	<Property Name="sonar.inclusions">
		src/UPS.WWRR.APP/**,
		src/UPS.WWRR.Business/**
	</Property>

	<!-- Exclude test and data projects from analysis -->
	<Property Name="sonar.exclusions">
		tests/**,
		src/UPS.WWRR.Data/**,
		src/UPS.WWRR.Business/DTO/Models/**,
		src/UPS.WWRR.Business/Common/Constants/**,
		src/UPS.WWRR.Business/Common/Enum/**
	</Property>

	<!-- Code coverage: only report for App and Business projects -->
	<Property Name="sonar.coverage.exclusions">
		tests/**,
		src/UPS.WWRR.Data/**,
		src/UPS.WWRR.Business/DTO/Models/**,
		src/UPS.WWRR.Business/Common/Constants/**,
		src/UPS.WWRR.Business/Common/Enum/**
	</Property>

	<!-- Path to the coverage report (generated by dotnet test with Coverlet) -->
	<Property Name="sonar.cs.opencover.reportsPaths">
		**/TestResults/**/coverage.opencover.xml
	</Property>

	<!-- Duplicate detection exclusions -->
	<Property Name="sonar.cpd.exclusions">
		tests/**
	</Property>

</SonarQubeAnalysisProperties>